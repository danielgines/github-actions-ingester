# Copy to .env (git-ignored). One credential shape only.

# --- Credential: personal access token (quick tests) ---
GHA_GITHUB_TOKEN=

# --- Credential: GitHub App (recommended; create it from examples/github-app/) ---
# GHA_GITHUB_APP_ID=
# GHA_GITHUB_APP_PRIVATE_KEY_FILE=./github-app.pem
# GHA_GITHUB_APP_INSTALLATION_ID=     # optional, auto-discovered

# --- Scope ---
GHA_ORGS=my-org
# GHA_REPOS=owner/name,owner/other
# GHA_EXCLUDE_REPOS=my-org/sandbox-*

# --- Database ---
GHA_DATABASE_URL=postgresql://gha:gha@localhost:5432/gha
# GHA_DATABASE_SCHEMA=gha

# --- Cadence ---
# GHA_POLL_INTERVAL_SECONDS=300
# GHA_BACKFILL_DAYS=30
# GHA_LOG_FORMAT=console
