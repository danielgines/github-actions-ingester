        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH w AS (\n  SELECT\n    r.full_name AS repo,\n    CASE WHEN '${showOrgName}' = 'no' THEN split_part(r.full_name, '/', 2) ELSE r.full_name END AS repo_label,\n    runs.conclusion\n  FROM minion_workflow_runs runs\n  JOIN minion_repositories r ON r.id = runs.repository_id\n  WHERE $__timeFilter(runs.started_at)\n    AND r.full_name IN ($repository)\n)\nSELECT\n  NOW() AS time,\n  repo_label AS metric,\n  100.0 * SUM(CASE WHEN conclusion = 'success' THEN 1 ELSE 0 END)::float / NULLIF(COUNT(*), 0) AS value\nFROM w\nGROUP BY repo_label\nORDER BY repo_label;\n",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "Overall repository success rate",
      "type": "gauge"
    },
