                "value": 80
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "overhead_pct"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "id": 12,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "total_workflow_runs"
          }
        ]
      },
      "pluginVersion": "12.1.1",
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH jobs_w AS (\n  SELECT\n    r.full_name AS repo,\n    CASE\n      WHEN '${showOrgName}' = 'no' THEN split_part(r.full_name, '/', 2)\n      ELSE r.full_name\n    END AS repo_label,\n    EXTRACT(EPOCH FROM (j.completed_at - j.started_at)) / 60.0 AS minutes\n  FROM minion_workflow_jobs j\n  JOIN minion_workflow_runs wr ON wr.id = j.run_id\n  JOIN minion_repositories r ON r.id = wr.repository_id\n  WHERE\n    $__timeFilter(j.started_at)\n    AND r.full_name IN ($repository)\n    AND j.started_at IS NOT NULL\n    AND j.completed_at IS NOT NULL\n),\nruns_w AS (\n  SELECT\n    CASE\n      WHEN '${showOrgName}' = 'no' THEN split_part(r.full_name, '/', 2)\n      ELSE r.full_name\n    END AS repo_label,\n    COUNT(*) AS total_workflow_runs,\n    COUNT(DISTINCT wr.workflow_file_id) AS workflow_files\n  FROM minion_workflow_runs wr\n  JOIN minion_repositories r ON r.id = wr.repository_id\n  WHERE\n    $__timeFilter(wr.started_at)\n    AND r.full_name IN ($repository)\n  GROUP BY repo_label\n)\nSELECT\n  j.repo_label AS repository_name,\n  SUM(CEIL(j.minutes)) AS github_minutes,\n  SUM(j.minutes)::float AS real_minutes,\n  100.0 * (SUM(CEIL(j.minutes)) - SUM(j.minutes)) / NULLIF(SUM(j.minutes), 0) AS overhead_pct,\n  COALESCE(r.workflow_files, 0) AS workflow_files,\n  COALESCE(r.total_workflow_runs, 0) AS total_workflow_runs\nFROM jobs_w j\nLEFT JOIN runs_w r ON r.repo_label = j.repo_label\nGROUP BY j.repo_label, r.workflow_files, r.total_workflow_runs\nORDER BY j.repo_label;\n",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "GitHub minutes overhead",
      "type": "table"
    },
