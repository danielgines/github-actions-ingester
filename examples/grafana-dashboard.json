          "editorMode": "code",
          "format": "time_series",
          "hide": false,
          "rawQuery": true,
          "rawSql": "SELECT\n  $__timeGroup(jobs.started_at, $aggregation, 0) AS time,\n  (CASE WHEN '${showOrgName}' = 'no' THEN split_part(r.full_name, '/', 2) ELSE r.full_name END) || ' → real_minutes' AS metric,\n  SUM(EXTRACT(EPOCH FROM (jobs.completed_at - jobs.started_at)) / 60) AS value\nFROM minion_workflow_jobs jobs\nJOIN minion_workflow_runs wr ON jobs.run_id = wr.id\nJOIN minion_repositories r ON wr.repository_id = r.id\nWHERE\n  $__timeFilter(jobs.started_at)\n  AND r.full_name IN ($repository)\n  AND jobs.started_at IS NOT NULL\n  AND jobs.completed_at IS NOT NULL\nGROUP BY time, metric\n\nUNION ALL\n\nSELECT\n  $__timeGroup(jobs.started_at, $aggregation, 0) AS time,\n  (CASE WHEN '${showOrgName}' = 'no' THEN split_part(r.full_name, '/', 2) ELSE r.full_name END) || ' → github_minutes' AS metric,\n  SUM(CEIL(EXTRACT(EPOCH FROM (jobs.completed_at - jobs.started_at)) / 60)) AS value\nFROM minion_workflow_jobs jobs\nJOIN minion_workflow_runs wr ON jobs.run_id = wr.id\nJOIN minion_repositories r ON wr.repository_id = r.id\nWHERE\n  $__timeFilter(jobs.started_at)\n  AND r.full_name IN ($repository)\n  AND jobs.started_at IS NOT NULL\n  AND jobs.completed_at IS NOT NULL\nGROUP BY time, metric\n\nORDER BY time;",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          },
          "table": "minion_workflow_jobs"
        }
      ],
